{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "version": "0.1.0",
  "minimum_chrome_version": "111",

  "permissions": ["storage"],
  "host_permissions": ["https://*.boardgamearena.com/*"],

  "background": { "service_worker": "sw.js" },

  "action": { "default_title": "__MSG_extName__", "default_icon": { "48": "icons/icon48.png" } },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },

  "options_ui": { "page": "options.html", "open_in_tab": true },

  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+W" },
      "description": "__MSG_cmdTogglePanel__"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://boardgamearena.com/*/wingspan*",
        "https://*.boardgamearena.com/*/wingspan*",
        "https://boardgamearena.com/archive/replay/*",
        "https://*.boardgamearena.com/archive/replay/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "world": "MAIN",
      "js": ["page.bundle.js"]
    },
    {
      "matches": [
        "https://boardgamearena.com/*/wingspan*",
        "https://*.boardgamearena.com/*/wingspan*",
        "https://boardgamearena.com/archive/replay/*",
        "https://*.boardgamearena.com/archive/replay/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "world": "ISOLATED",
      "js": ["ui.bundle.js"]
    }
  ]
}
